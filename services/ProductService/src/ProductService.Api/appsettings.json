{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    "CommandTimeoutSeconds": 15
  },
  "RequestTimeouts": {
    "DefaultMs": 10000,
    "ReadMs": 5000,
    "WriteMs": 10000
  },
  "CircuitBreaker": {
    "FailureRatio": 0.5,
    "MinimumThroughput": 5,
    "SamplingDurationSeconds": 30,
    "BreakDurationSeconds": 15,
    "MaxRetryAttempts": 2,
    "RetryBaseDelayMs": 100,
    "RetryUseJitter": true,
    "BulkheadMaxParallelization": 32,
    "BulkheadMaxQueuedActions": 16
  },
  "AllowedHosts": "*"
}



