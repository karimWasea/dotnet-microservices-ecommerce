{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OrderWriteDb": "Host=localhost;Port=5432;Database=orderdb;Username=postgres;Password=postgres",
    "OrderReadDb": "Host=localhost;Port=5432;Database=orderreaddb;Username=postgres;Password=postgres"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "ExchangeName": "ecommerce.events",
    "DeadLetterExchangeName": "ecommerce.events.dlx",
    "Enabled": true
  },
  "ProductCatalog": {
    "BaseUrl": "http://localhost:5001",
    "TotalTimeoutSeconds": 8.0,
    "AttemptTimeoutSeconds": 2.0,
    "MaxRetryAttempts": 2,
    "BaseRetryDelayMs": 200,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerMinimumThroughput": 6,
    "CircuitBreakerSamplingDurationSeconds": 30.0,
    "CircuitBreakerBreakDurationSeconds": 20.0
  },
  "JwtAuth": {
    "Issuer": "ecommerce-user-service",
    "Audience": "ecommerce-clients",
    "JwksUrl": "http://localhost:5002/.well-known/jwks.json",
    "RefreshIntervalMinutes": 10,
    "MaxStaleHours": 24
  },
  "OrderExpiration": {
    "Enabled": true,
    "CheckIntervalSeconds": 30,
    "StaleThresholdMinutes": 5,
    "BatchSize": 20
  }
}
