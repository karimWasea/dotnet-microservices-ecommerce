# PostgreSQL credentials for local Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Development Admin password seeded in UserService (admin@ecommerce.local)
SEED_ADMIN_PASSWORD=Admin@123456!

# Optional: PEM-encoded PKCS#8 RSA private key for UserService JWT signing
# In Development, if omitted, UserService generates a key in .keys/userservice-dev-rsa.pem
JWT_PRIVATE_KEY_PEM=
